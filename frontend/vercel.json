{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/place-cron.js": {
      "maxDuration": 300
    },
    "api/place.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/place-cron",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/place/:path*",
      "destination": "/api/place?path=:path*"
    },
    {
      "source": "/api/swap",
      "destination": "/api/agent?route=swap"
    },
    {
      "source": "/api/agent/:route(act|token|settings)",
      "destination": "/api/agent?route=:route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
