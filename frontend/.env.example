# Serverless functions (frontend/api), set in Vercel. Never commit real values.

# Alchemy key for Place snapshots and hub state (Base and Base Sepolia)
ALCHEMY_API_KEY=

# Place: Neon Postgres (pooled connection string). Apply the schema with `npm run db:migrate`.
DATABASE_URL=
# Optional: nodes for event logs, comma-separated (default: publicnode). Alchemy's free tier allows
# only 10-block eth_getLogs ranges, so logs come from a node with wider ranges.
PLACE_LOGS_RPC=
# Optional: addresses per eth_getLogs (publicnode allows 10)
PLACE_LOGS_MAX_ADDRESSES=

# Place Launch keeper (/api/place-cron): a hot wallet with a little ETH for gas that calls the permissionless
# process() and startDefaultCampaign() of 0.2.0 creator vaults once a day. Without it the keeper is off.
PLACE_KEEPER_PRIVATE_KEY=
# Optional: seconds between calls per vault (86400), gas cap per call (800000), calls per tick (20)
PLACE_KEEPER_INTERVAL_S=
PLACE_KEEPER_MAX_GAS=
PLACE_KEEPER_MAX_CALLS=

# Agent features (next upgrade). Unused while FEATURES.agents (src/config/features.js) is off.

# Upstash Redis for agent keys and settings (either pair works).
# Without it, `npm run dev` keeps data in frontend/.data.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Privy (Place app), for agent wallet signing. PRIVY_APP_ID defaults to the Place app; PRIVY_SIGNER_ID and
# VITE_PRIVY_SIGNER_ID are the key quorum id of the Place app (no default: agent access stays off without it).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_SIGNER_ID=

# Optional: daily caps for agent transfers to other addresses. Defaults: 5 ETH, 10,000 USDC
AGENT_DAILY_LIMIT_ETH=
AGENT_DAILY_LIMIT_USDC=

# Agent features (next upgrade): the client side of the Privy signer above.
VITE_PRIVY_SIGNER_ID=

# Optional client overrides (Vite). Each one defaults to the value in the code.
# Privy app for the site (default: the Place app). Each origin the site runs on must be allowed in the Privy dashboard.
VITE_PRIVY_APP_ID=
# Place: chain for the portal (default 84532, Base Sepolia) and an optional API root.
VITE_PLACE_CHAIN=
VITE_PLACE_API=
